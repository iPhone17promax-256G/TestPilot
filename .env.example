# Run python3 scripts/setup.py to generate private database passwords.
AIQA_DB_PASSWORD=replace_with_generated_password
AIQA_DB_ROOT_PASSWORD=replace_with_generated_root_password
AIQA_DATABASE_URL=mysql+pymysql://aiqa:replace_with_generated_password@mysql:3306/aiqa?charset=utf8mb4
# Absolute Linux path resolved by the Docker daemon, not a Windows UNC path.
AIQA_HOST_DATA=/absolute/path/to/AIQA/.runtime
AIQA_DATA=/data
AIQA_RUNNER_IMAGE=aiqa-runtime:0.1
AIQA_TARGET_NETWORK=aiqa-targets
AIQA_MODEL=ark-code-latest
AIQA_MODEL_URL=
AIQA_MODEL_KEY=
AIQA_MAX_STEPS=24
AIQA_TASK_TIMEOUT=900
AIQA_ACCESS_TOKEN=
TEST_USERNAME=
TEST_PASSWORD=
TEST_TOKEN=
