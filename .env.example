# 运行 python3 scripts/setup.py 生成本次安装的数据库密码；这里的占位密码不是可用凭据。
TESTPILOT_DB_PASSWORD=replace_with_generated_password
TESTPILOT_DB_ROOT_PASSWORD=replace_with_generated_root_password
TESTPILOT_DATABASE_URL=mysql+pymysql://testpilot:replace_with_generated_password@mysql:3306/testpilot?charset=utf8mb4
# Redis 只在平台管理网络开放，不发布宿主端口；执行器不需要此 URL。
TESTPILOT_REDIS_PASSWORD=replace_with_generated_password
TESTPILOT_REDIS_URL=redis://:replace_with_generated_password@redis:6379/0
# TESTPILOT_HOST_DATA 是 Docker 守护进程可访问的 Linux 绝对目录，用于挂载测试工作区；不能填 Windows UNC 路径或只在执行器容器内部存在的路径。
TESTPILOT_HOST_DATA=/absolute/path/to/TestPilot/.runtime
# 控制台/API/执行服务仅接受 HTTPS；开发启动默认生成到仓库 .tls，并要求客户端信任 rootCA.pem。
# 自定义证书目录用环境变量 TESTPILOT_TLS_DIR，须是宿主机 Linux 绝对路径，放在 .runtime/.client 之外。
# .tls/rootCA-key.pem 是签发私钥，不能提交、分享或挂载到常驻服务；服务只挂载各自证书、私钥和公开 CA bundle。
TESTPILOT_DATA=/data
TESTPILOT_RUNNER_IMAGE=testpilot-runtime:0.1
TESTPILOT_TARGET_NETWORK=testpilot-targets
TESTPILOT_MODEL=ark-code-latest
TESTPILOT_MODEL_URL=
TESTPILOT_MODEL_KEY=
TESTPILOT_MAX_STEPS=24
TESTPILOT_TASK_TIMEOUT=900
TESTPILOT_ACCESS_TOKEN=
TEST_USERNAME=
TEST_PASSWORD=
TEST_TOKEN=
TESTPILOT_QDRANT_URL=http://qdrant:6333
TESTPILOT_QDRANT_API_KEY=
